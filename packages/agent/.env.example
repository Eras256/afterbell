# Solana RPC endpoint. Use a Helius mainnet URL for reliability during the launch.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# EITHER a base58 secret key...
TEAM_WALLET_SECRET_KEY=

# ...OR a path to a Solana CLI-style keypair JSON file (created by 00-generate-wallet.ts)
TEAM_WALLET_KEYPAIR_PATH=../../secrets/team-wallet.json
